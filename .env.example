# Bizflow Car Parking System - Web Environment Configuration
# Copy this file to .env and configure your Firebase Web App credentials.
# Note: Values should only come from your standard Firebase Project Web App config.
# NEVER place private service account keys or private admin credentials here.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=car-parking-system-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=car-parking-system-2026
VITE_FIREBASE_STORAGE_BUCKET=car-parking-system-2026.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_web_app_id_here
